# Sanity CMS (Optional)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=

# Analytics (Optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=

# Contact Form Email
CONTACT_EMAIL=serasakreatif.id@gmail.com

# Site URL (for absolute URLs in metadata)
NEXT_PUBLIC_SITE_URL=https://serasakreatif.id

# Resend Email Integration
RESEND_API_KEY=

# Sentry Error Tracking (Optional — https://sentry.io free tier)
# 1. Sign up at sentry.io → New Project → Next.js → copy DSN below
# 2. NEXT_PUBLIC_SENTRY_DSN only activates in NODE_ENV=production
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Enable source map upload for better stack traces
# Requires SENTRY_AUTH_TOKEN from sentry.io → Settings → Auth Tokens
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
